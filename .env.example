# ===================== 필수 =====================
# 디스코드 봇 토큰 (기존 키 이름 TOKEN 도 인식)
DISCORD_TOKEN=
# Gemini API 키 (기존 키 이름 API 도 인식)
GEMINI_API_KEY=

# ===================== 관리 웹 =====================
# 비워 두면 관리 웹이 인증 없이 열립니다. 홈서버라도 꼭 설정하세요.
ADMIN_USER=admin
ADMIN_PASSWORD=
# 호스트에 노출할 포트 (docker-compose)
ADMIN_WEB_PORT=8080
FALKORDB_BROWSER_PORT=3000

# ===================== 모델 =====================
# LLM(그래프 추출) · 리랭커 · 채팅 답변 모두 이 모델 하나로 통일
GEMINI_MODEL=gemini-3.5-flash-lite
# 임베딩은 생성형 모델로 만들 수 없어 전용 모델 사용
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 사고(thinking) 토큰 절약: minimal | low | medium | high (빈 값 = 모델 기본)
GRAPH_THINKING_LEVEL=minimal
CHAT_THINKING_LEVEL=low
# 봇이 스스로를 부르는 이름 (대화·기억에 이 이름으로 기록됨)
BOT_NAME=라스페치아
# 페르소나를 바꾸고 싶으면 한 줄로 작성
# BOT_PERSONA=너는 츤데레 고양이 말투를 쓰는 디스코드 친구다.

# ===================== 기억 동작 =====================
SHORT_TERM_SIZE=10          # 채널별 단기 기억(최근 메시지 수)
BATCH_MAX_MESSAGES=8        # 이만큼 쌓이면 바로 저장
BATCH_IDLE_SECONDS=90       # 이 시간 동안 대화가 없으면 저장 (디바운스)
BATCH_MAX_CHARS=6000        # 버퍼 글자 수 상한
MIN_MESSAGE_CHARS=10        # 봇과 무관한 대화는 이보다 짧으면 무시
CAPTURE_ALL_MESSAGES=false  # true 면 봇을 부르지 않은 채널 대화도 기억 (토큰↑)
MEMORY_SEARCH_LIMIT=8       # 답변에 넣을 관련 사실 수
MEMORY_NODE_LIMIT=4         # 답변에 넣을 관련 엔티티 요약 수

# ===================== 429 / 안정성 =====================
GEMINI_RPM=0                # 분당 Gemini 호출 상한 (0 = 제한 없음, 무료 티어면 10~15 권장)
MAX_CONCURRENT_EPISODES=1   # 동시에 처리할 기억 저장 수
MAX_CONCURRENT_CHATS=4      # 동시에 생성할 답변 수
GRAPHITI_MAX_COROUTINES=4   # Graphiti 내부 병렬도
GEMINI_MAX_RETRIES=5        # 호출 단위 429 재시도 횟수
EPISODE_MAX_RETRIES=4       # 에피소드 단위 재시도 횟수

# ===================== 기타 =====================
# 슬래시 명령을 특정 서버에 즉시 반영하려면 서버 ID 입력 (전역 반영은 최대 1시간)
# DEV_GUILD_ID=
LOG_LEVEL=INFO
